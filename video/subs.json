[[0.453, 2.203, "干燥的纤维布。"], [2.2430000000000003, 4.113, "再加一点树脂。"], [4.1530000000000005, 8.163, "它们怎样变成又轻又强的复合材料板？"], [8.203, 9.914708000000001, "给我们一分钟。"], [10.067708, 12.278708000000002, "首先需要一个模具。"], [12.318708, 14.060708000000002, "一个树脂罐。"], [14.100708000000001, 17.065708, "一台真空泵，把空气抽走。"], [17.105708, 20.748708, "一个缓冲罐，让真空保持稳定。"], [20.788708, 24.438583, "还有一个树脂收集器，保护真空泵。"], [24.591583000000004, 26.496583, "现在开始铺层。"], [26.536583000000004, 31.057583, "先涂脱模剂，让制品不粘模具、便于脱模。"], [31.097583000000004, 34.88758300000001, "再铺增强纤维布，按正确的方向。"], [34.927583000000006, 37.879583000000004, "然后是脱模布和导流网。"], [37.919583, 41.735583000000005, "树脂从一侧流入，另一侧抽出空气。"], [41.775583000000005, 45.024333, "最后是密封胶条和真空袋膜。"], [45.177333000000004, 46.188333, "抽真空："], [46.228333000000006, 48.691333, "袋膜紧紧贴住铺层。"], [48.73133300000001, 52.148333, "打开阀门，大气压把树脂压进去。"], [52.188333, 55.696375, "树脂浸透纤维布，然后固化。"], [55.849375, 56.969375, "脱模。"], [57.009375, 63.332832999999994, "袋膜、导流网和脱模布一起\n揭下，成品板从模具上脱开。"], [63.485833, 65.616833, "这就是全部配方。"], [65.65683299999999, 68.481833, "复合材料，一看就懂。"]]