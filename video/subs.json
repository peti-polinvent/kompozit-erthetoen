[[0.452, 1.7319999999999998, "Száraz szövet."], [1.772, 3.1310000000000002, "És egy kis gyanta."], [3.1710000000000003, 6.313000000000001, "Hogyan lesz ezekből könnyű és erős kompozit lap?"], [6.353000000000001, 8.559958, "Egy perc, és megmutatjuk."], [8.711958, 10.486958, "Kell egy szerszám."], [10.549957999999998, 12.389958, "Egy gyantatartály."], [12.476958, 15.904958, "Egy vákuumszivattyú, ami kiszívja a levegőt."], [16.031958, 20.045958, "Egy puffertartály, ami egyenletesen tartja a\nvákuumot."], [20.185958, 23.344250000000002, "És egy gyantacsapda, ami megvédi a szivattyút."], [23.49625, 25.19225, "Most a rétegek."], [25.33425, 29.40025, "Formaleválasztó, hogy a termék ne tapadjon a\nszerszámhoz."], [29.54025, 33.11125, "Erősítő szövetek, a megfelelő irányokban."], [33.18625, 36.27525, "Letépő szövet és gyantavezető háló."], [36.389250000000004, 40.806250000000006, "Az egyik szélén belép a gyanta, a másikon\nelszívjuk a levegőt."], [40.946250000000006, 43.763417000000004, "Végül tömítőszalag és vákuumfólia."], [43.915417, 44.695417, "Vákuum be:"], [44.735417, 47.239416999999996, "a fólia ráfeszül a rétegekre."], [47.368417, 50.965416999999995, "Nyílik a csap, és a légnyomás betolja a gyantát."], [51.092417, 54.194625, "Átitatja a szöveteket – aztán megkeményedik."], [54.346624999999996, 55.769625, "Bontás."], [55.885625, 61.739374999999995, "A fólia, a háló és a letépő szövet egyben lejön,\na kész lap pedig leválik a szerszámról."], [61.891375, 63.522375, "Ennyi a recept."], [63.651375, 65.690375, "Kompozit – érthetően."]]