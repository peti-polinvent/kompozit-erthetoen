[[0.45, 6.323, "Száraz szövet, egy kis gyanta – hogyan lesz\nbelőle erős, könnyű kompozit lap?"], [6.363, 9.26125, "Egy perc, és megmutatjuk."], [9.411249999999999, 11.44625, "Kell egy szerszám."], [11.486249999999998, 13.558250000000001, "Egy gyantatartály."], [13.59825, 17.70925, "Egy vákuumszivattyú, ami kiszívja a levegőt."], [17.74925, 22.33325, "Egy puffertartály, ami egyenletesen tartja a\nvákuumot."], [22.37325, 26.180833, "És egy gyantacsapda, ami megvédi a szivattyút."], [26.330833000000002, 28.340833, "Most a rétegek."], [28.380833, 32.177833, "Formaleválasztó, hogy semmi ne ragadjon."], [32.217833000000006, 36.315833, "Erősítő szövetek, a megfelelő irányokban."], [36.355833000000004, 39.840833, "Letépő szövet és gyantavezető háló."], [39.880833, 44.928833, "Az egyik szélén belép a gyanta, a másikon\nelszívjuk a levegőt."], [44.968833000000004, 48.358833000000004, "Végül tömítőszalag és vákuumfólia."], [48.508833, 49.705833, "Vákuum be:"], [49.745833000000005, 52.456832999999996, "a fólia ráfeszül a rétegekre."], [52.496833, 56.643833, "Nyílik a csap, és a légnyomás betolja a gyantát."], [56.683833, 60.222791, "Átitatja a szöveteket – aztán megkeményedik."], [60.372791, 62.11979099999999, "Bontás."], [62.159791, 68.931124, "A fólia, a háló és a letépő szövet egyben lejön,\na kész lap pedig leválik a szerszámról."], [69.08112399999999, 71.091124, "Ennyi a recept."], [71.131124, 73.43799899999999, "Kompozit – érthetően."]]