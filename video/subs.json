[[0.453, 2.203, "干燥的纤维布。"], [2.2430000000000003, 4.113, "再加一点树脂。"], [4.1530000000000005, 8.163, "它们怎样变成又轻又强的复合材料板？"], [8.203, 9.914708000000001, "给我们一分钟。"], [10.067708, 12.278708000000002, "首先需要一个模具。"], [12.318708, 14.060708000000002, "一个树脂罐。"], [14.100708000000001, 17.065708, "一台真空泵，把空气抽走。"], [17.105708, 20.748708, "一个缓冲罐，让真空保持稳定。"], [20.788708, 24.438583, "还有一个树脂收集器，保护真空泵。"], [24.591583000000004, 26.496583, "现在开始铺层。"], [26.536583000000004, 29.568583000000004, "先涂脱模剂，防止粘连。"], [29.608583000000003, 33.397583000000004, "再铺增强纤维布，按正确的方向。"], [33.437583000000004, 36.389583, "然后是脱模布和导流网。"], [36.42958300000001, 40.246583, "树脂从一侧流入，另一侧抽出空气。"], [40.28658300000001, 43.532833000000004, "最后是密封胶条和真空袋膜。"], [43.68583300000001, 44.696833000000005, "抽真空："], [44.736833000000004, 47.199833000000005, "袋膜紧紧贴住铺层。"], [47.239833000000004, 50.656833000000006, "打开阀门，大气压把树脂压进去。"], [50.696833000000005, 54.20487500000001, "树脂浸透纤维布，然后固化。"], [54.357875000000014, 55.47787500000001, "脱模。"], [55.51787500000001, 61.841333000000006, "袋膜、导流网和脱模布一起\n揭下，成品板从模具上脱开。"], [61.99433300000001, 64.12533300000001, "这就是全部配方。"], [64.165333, 66.990333, "复合材料，一看就懂。"]]