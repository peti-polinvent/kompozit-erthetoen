[[0.452, 1.7319999999999998, "Száraz szövet."], [1.772, 3.1310000000000002, "És egy kis gyanta."], [3.1710000000000003, 6.313000000000001, "Hogyan lesz ezekből könnyű és erős kompozit lap?"], [6.353000000000001, 8.559958, "Egy perc, és megmutatjuk."], [8.711958, 10.486958, "Kell egy szerszám."], [10.549957999999998, 12.389958, "Egy gyantatartály."], [12.476958, 15.904958, "Egy vákuumszivattyú, ami kiszívja a levegőt."], [16.031958, 20.045958, "Egy puffertartály, ami egyenletesen tartja a\nvákuumot."], [20.185958, 23.344250000000002, "És egy gyantacsapda, ami megvédi a szivattyút."], [23.49625, 25.19225, "Most a rétegek."], [25.33425, 28.58025, "Formaleválasztó, hogy semmi ne ragadjon."], [28.65425, 32.22625, "Erősítő szövetek, a megfelelő irányokban."], [32.300250000000005, 35.39025, "Letépő szövet és gyantavezető háló."], [35.50325, 39.92125, "Az egyik szélén belép a gyanta, a másikon\nelszívjuk a levegőt."], [40.06125, 42.878333, "Végül tömítőszalag és vákuumfólia."], [43.030333, 43.810333, "Vákuum be:"], [43.850333, 46.354333, "a fólia ráfeszül a rétegekre."], [46.483333, 50.080332999999996, "Nyílik a csap, és a légnyomás betolja a gyantát."], [50.207333000000006, 53.309540999999996, "Átitatja a szöveteket – aztán megkeményedik."], [53.461541, 54.884541, "Bontás."], [55.000541, 60.854290999999996, "A fólia, a háló és a letépő szövet egyben lejön,\na kész lap pedig leválik a szerszámról."], [61.006291, 62.637291, "Ennyi a recept."], [62.766291, 64.805291, "Kompozit – érthetően."]]